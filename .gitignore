# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- node ---
node_modules/
frontend/dist/
frontend/test-results/

# --- runtime state and logs ---
reports/*.txt

# --- original download archives, kept locally only ---
archive/

# --- data: local only ---------------------------------------------------------
# Nothing under data/ is committed. It stays on disk (61 MB) and is rebuilt from
# the original DBAASP and DRAMP downloads — see docs/08-data-setup.md.
#
# Two items in here must never be committed even if this rule is relaxed again:
#   data/.jwt_secret   per-install JWT signing key; publishing it forges any login
#   data/pharmamind.db real accounts and bcrypt password hashes
data/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
