# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- node ---
node_modules/
frontend/dist/
frontend/test-results/

# --- large regenerable artefacts -------------------------------------------
# embeddings.npz is 28 MB and rebuilds in ~75 s: python src/embed.py
data/processed/embeddings.npz
# intermediate pickles from the data pair's cleaning step; the CSVs are the source of truth
data/processed/*_normalized.pkl
# cached PDB downloads, refetched on demand
data/structures/

# --- runtime state ---
data/*.db
data/*.sqlite3
reports/*.txt

# --- original download archives, kept locally only ---
archive/

# --- secrets and per-install state, never committed -------------------------
# JWT signing key: generated per install, publishing it forges any login
data/.jwt_secret
# the running database holds real accounts and bcrypt hashes; seed your own
# with python src/seed.py
data/*.db-shm
data/*.db-wal

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
