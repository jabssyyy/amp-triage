data/processed/*_normalized.pkl
# cached PDB downloads, refetched on demand
data/structures/

# --- runtime state ---
data/*.db
data/*.sqlite3
reports/*.txt

# --- original download archives, kept locally only ---
archive/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
data/*.db-shm
data/*.db-wal
data/.jwt_secret

# --- third-party datasets, not redistributed ---------------------------------
